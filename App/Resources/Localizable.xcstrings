    "Extend one arm, palm up, and gently pull your fingers back. Hold for 15 seconds, then switch.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extiende un brazo con la palma hacia arriba y tira suavemente de los dedos hacia atrás. Mantén 15 segundos y cambia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estenda um braço com a palma para cima e puxe os dedos suavemente para trás. Segure por 15 segundos e troque."
