            "value": "Mais 5 minutos"
          }
        }
      }
    },
    "50-minute sessions on weekdays from 9 to 6, with posture checks.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones de 50 minutos entre semana de 9 a 18, con revisiones de postura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões de 50 minutos em dias úteis, das 9h às 18h, com checagens de postura."
          }
        }
      }
    },
    "7 Days": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "7 días"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dias"
          }
        }
      }
    },
    "90-minute sessions and fewer, combined interruptions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones de 90 minutos y menos interrupciones, agrupadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões de 90 minutos e menos interrupções, agrupadas."
          }
        }
      }
    },
    "A common reference is about 2 to 2.5 liters of water a day, including water from food. Adjust it to your body, activity, and climate.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una referencia común es de unos 2 a 2,5 litros de agua al día, incluida el agua de los alimentos. Ajústala a tu cuerpo, actividad y clima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma referência comum é de cerca de 2 a 2,5 litros de água por dia, incluindo a água dos alimentos. Ajuste ao seu corpo, nível de atividade e clima."
          }
        }
      }
    },
    "A gentle companion for long days at the computer. It lives in your menu bar.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compañero amable para largas jornadas frente a la computadora. Vive en tu barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um companheiro gentil para longos dias no computador. Ele fica na sua barra de menus."
          }
        }
      }
    },
    "A new focus session has started.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha comenzado una nueva sesión de concentración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova sessão de foco começou."
          }
        }
      }
    },
    "A quiet notification with today's focus time, standing time, and water. With working hours on, it arrives when your workday ends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación silenciosa con tu tiempo de concentración, tiempo de pie y agua de hoy. Con el horario laboral activado, llega al terminar tu jornada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação silenciosa com seu tempo de foco, tempo em pé e água de hoje. Com o horário de trabalho ativado, ela chega quando seu expediente termina."
          }
        }
      }
    },
    "A quiet nudge, without sound, to relax your shoulders and sit back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso discreto, sin sonido, para relajar los hombros y apoyar la espalda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete discreto, sem som, para relaxar os ombros e encostar as costas."
          }
        }
      }
    },
