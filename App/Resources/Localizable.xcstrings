    "There's nothing magic about 25 minutes. Pick the rhythm that keeps you focused without wearing you out.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 25 minutos no tienen nada de mágico. Elige el ritmo que te mantenga concentrado sin agotarte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada de mágico nos 25 minutos. Escolha o ritmo que mantém você focado sem se desgastar."
          }
        }
      }
    },
