    "Alternating matters more than standing a lot. Recommendations range from 5 to 45 minutes of standing per hour, and standing for hours at a time can cause back pain too.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar importa más que estar mucho tiempo de pie. Las recomendaciones van de 5 a 45 minutos de pie por hora, y estar de pie durante horas también puede causar dolor de espalda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar importa mais do que ficar muito tempo em pé. As recomendações vão de 5 a 45 minutos em pé por hora, e ficar em pé por horas seguidas também pode causar dor nas costas."
          }
        }
      }
    },
