    "Every 20 minutes, look at something about 6 meters (20 feet) away for 20 seconds. Evidence is mixed, but it's an easy habit that many people find relieving.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 20 minutos, mira algo a unos 6 metros durante 20 segundos. La evidencia es mixta, pero es un hábito sencillo que a mucha gente le alivia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 20 minutos, olhe para algo a cerca de 6 metros por 20 segundos. As evidências são mistas, mas é um hábito simples que alivia muita gente."
          }
        }
      }
    },
