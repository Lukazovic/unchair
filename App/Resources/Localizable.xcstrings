    "Held reminders are delivered as soon as the call ends or you leave full screen. Pomodoro notifications still arrive, silently.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios en espera llegan en cuanto termina la llamada o sales de la pantalla completa. Las notificaciones del Pomodoro siguen llegando, en silencio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes em espera chegam assim que a chamada termina ou você sai da tela cheia. As notificações do Pomodoro continuam chegando, em silêncio."
          }
        }
      }
    },
    "Held while an app is full screen": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En espera mientras una app está en pantalla completa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em espera enquanto um app está em tela cheia"
          }
        }
      }
    },
    "Held while you're away": {
