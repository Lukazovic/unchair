    "Clasp your hands behind your back, straighten your arms, and gently lift your chest for 20 seconds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrelaza las manos detrás de la espalda, estira los brazos y eleva suavemente el pecho durante 20 segundos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrelace as mãos atrás das costas, estique os braços e eleve suavemente o peito por 20 segundos."
          }
        }
      }
    },
