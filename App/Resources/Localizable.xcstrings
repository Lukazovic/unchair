    "To hold reminders during a Focus, open a Focus in System Settings, choose Add Filter, and pick Unchair.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poner los recordatorios en espera durante un modo de concentración, abre uno en Ajustes del Sistema, elige Añadir filtro y selecciona Unchair."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para colocar os lembretes em espera durante um Foco, abra um Foco nos Ajustes do Sistema, escolha Adicionar Filtro e selecione Unchair."
          }
        }
      }
    },
    "Turned off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivadas"
          }
        },
        "pt-BR": {
