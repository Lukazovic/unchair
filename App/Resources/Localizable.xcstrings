            "value": "Desativadas"
          }
        }
      }
    },
    "Unchair": {
      "shouldTranslate": false
    },
    "Unchair notices when you stop using the computer, it goes to sleep, or the screen locks. Time away counts as a break: your sitting time starts over when you're back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unchair detecta cuando dejas de usar la computadora, entra en reposo o se bloquea la pantalla. El tiempo fuera cuenta como descanso: tu tiempo sentado empieza de nuevo al volver."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Unchair percebe quando você para de usar o computador, ele entra em repouso ou a tela é bloqueada. O tempo fora conta como pausa: seu tempo sentado recomeça quando você volta."
          }
        }
      }
    },
    "Unknown": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconocido"
