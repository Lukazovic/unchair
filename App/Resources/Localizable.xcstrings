    "25-minute sessions, eye breaks, and frequent water.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones de 25 minutos, descansos visuales y agua frecuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões de 25 minutos, pausas para os olhos e água com frequência."
          }
        }
      }
    },
    "30 Days": {
      "localizations": {
        "es": {
