    "When a focus session is running, Unchair holds the reminder until your next break so it doesn't interrupt you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hay una sesión de concentración en curso, Unchair retiene el recordatorio hasta tu próximo descanso para no interrumpirte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma sessão de foco está em andamento, o Unchair segura o lembrete até a próxima pausa para não interromper você."
