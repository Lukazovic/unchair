            "value": "Tudo pronto"
          }
        }
      }
    },
    "Your current settings stay as they are unless you pick one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu configuración actual se mantiene a menos que elijas uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus ajustes atuais continuam como estão, a menos que você escolha um."
          }
        }
      }
    },
    "Your day with Unchair": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu día con Unchair"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu dia com o Unchair"
          }
        }
      }
    },
    "Your focus sessions, sitting and standing time, water, and reminder history will be removed from this Mac. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus sesiones de concentración, tiempo sentado y de pie, agua e historial de recordatorios se eliminarán de esta Mac. No se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas sessões de foco, tempo sentado e em pé, água e histórico de lembretes serão removidos deste Mac. Não é possível desfazer."
          }
        }
      }
    },
    "Your history stays on this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu historial se queda en esta Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu histórico fica neste Mac."
          }
        }
      }
    },
    "Your long break has started. You've earned it.": {
